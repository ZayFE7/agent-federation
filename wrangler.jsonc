{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-federation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    { "binding": "ROUTER", "service": "zay-router" },
    { "binding": "SANDBOX", "service": "zay-sandbox" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEDERATION_AGENT",
        "class_name": "FederationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FederationAgent"]
    }
  ],
  // Keep-alive cron: pings RENDER_URL/health every 10 minutes so the free
  // Render instance never idles into sleep (744h/month budget stays safe).
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // Public vars (non-secret). Replace ROUTER_URL with your trigger URL.
  // Local dev: .dev.vars overrides these for the keys it defines.
  // RENDER_URL is added after the Render service has its public URL.
  "vars": {
    "MODEL_PRIMARY": "gemini3.7flash",
    "MODEL_CHEAP": "gemini3.8flash"
  },
  // Secrets (never put these in vars):
  //   wrangler secret put ROUTER_KEY        (bearer for the model router)
  //   wrangler secret put AGENT_API_KEY     (bearer the web UI / API must present)
  //   wrangler secret put SBOX_TOKEN        (must match zay-sandbox's SBOX_TOKEN)
  //   wrangler secret put PARALLEL_API_KEY  (Parallel Web Search; enables web_search)
  //   wrangler secret put ROUTER_URL        (omniroute tunnel URL; NEVER commit it, rule 8)
  // The zay-sandbox worker holds its own secrets (see deploy/sandbox-worker):
  //   E2B_API_KEY, SBOX_TOKEN (same value as above).
}
