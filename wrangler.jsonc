{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-federation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    { "binding": "ROUTER", "service": "zay-router" },
    { "binding": "SANDBOX", "service": "zay-sandbox" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEDERATION_AGENT",
        "class_name": "FederationAgent"
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FederationAgent"]
    },
    // RegistryAgent lands in its own NEW tag: an applied migration is never
    // edited, which is the mistake wrangler warns about (plan Task 6 Step 1).
    {
      "tag": "v2",
      "new_sqlite_classes": ["RegistryAgent"]
    },
    // Researcher is a dynamic-agent facet (Task 31): the SDK instantiates it from
    // the exported class and an id taken from the ROOT namespace, so it has its
    // own SQLite and no binding of its own. An applied migration is never edited,
    // so this is a new tag (same rule as v2 above).
    {
      "tag": "v3",
      "new_sqlite_classes": ["Researcher"]
    }
  ],
  // Keep-alive cron: pings RENDER_URL/health every 10 minutes so the free
  // Render instance never idles into sleep (744h/month budget stays safe).
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // Public vars (non-secret). Replace ROUTER_URL with your trigger URL.
  // Local dev: .dev.vars overrides these for the keys it defines.
  // RENDER_URL is added after the Render service has its public URL.
  // MODEL_* use the `cf/` catalog form, which only the omniroute funnel resolves,
  // so ROUTER_URL must be the funnel (see src/types.ts). Both tiers are on one id
  // while the deepseek free tier cools down; the console's model picker overrides
  // the primary per session without a redeploy.
  "vars": {
    "MODEL_PRIMARY": "cf/@cf/qwen/qwen3.8-27b",
    "MODEL_CHEAP": "cf/@cf/qwen/qwen3.8-27b"
  },
  // Secrets (never put these in vars):
  //   wrangler secret put ROUTER_KEY        (bearer for the model router)
  //   wrangler secret put AGENT_API_KEY     (bearer the web UI / API must present)
  //   wrangler secret put SBOX_TOKEN        (must match zay-sandbox's SBOX_TOKEN)
  //   wrangler secret put PARALLEL_API_KEY  (Parallel Web Search; enables web_search)
  //   wrangler secret put ROUTER_URL        (omniroute tunnel URL; NEVER commit it, rule 8)
  // The zay-sandbox worker holds its own secrets (see deploy/sandbox-worker):
  //   E2B_API_KEY, SBOX_TOKEN (same value as above).
}
